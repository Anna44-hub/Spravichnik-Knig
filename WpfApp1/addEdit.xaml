<Window x:Class="WpfApp1.addEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="addEdit" Height="450" Width="800">
    <StackPanel Margin="50">
        <TextBox x:Name="Title" Text="{Binding Title, 
UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="10"/>
        <TextBox x:Name="Author" Text="{Binding Author, 
UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="10"/>
        <TextBox x:Name="Year"  Text="{Binding Year, 
UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="10"/>
        <Button Content="Добавить" Width="300" FontSize="25" Click="Button_Click"/>
    </StackPanel>
</Window>
